# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxx.mongodb.net/jeyp-store?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=jeyp_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# Server
PORT=8000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (Gmail SMTP)
# For Gmail: enable 2FA → generate App Password at myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# Leave EMAIL_USER and EMAIL_PASS empty to use DEV MODE
# (OTP will be printed in terminal instead of sent by email)
